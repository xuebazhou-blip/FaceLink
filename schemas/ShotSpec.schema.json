{
  "$defs": {
    "CameraSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "FaceLink Camera",
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "default": "static",
          "enum": [
            "static",
            "look_at",
            "follow",
            "dolly_in"
          ],
          "title": "Mode",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lens_mm": {
          "default": 50.0,
          "maximum": 300.0,
          "minimum": 1.0,
          "title": "Lens Mm",
          "type": "number"
        },
        "distance": {
          "default": 6.0,
          "exclusiveMinimum": 0.0,
          "title": "Distance",
          "type": "number"
        },
        "height": {
          "default": 2.0,
          "title": "Height",
          "type": "number"
        }
      },
      "title": "CameraSpec",
      "type": "object"
    },
