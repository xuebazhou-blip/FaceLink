          "mapping": {
            "look_at": "#/$defs/LookAtBeat",
            "move_to": "#/$defs/MoveToBeat",
            "play_clip": "#/$defs/PlayClipBeat",
            "turn_to": "#/$defs/TurnToBeat",
            "wait": "#/$defs/WaitBeat"
