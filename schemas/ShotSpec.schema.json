            "$ref": "#/$defs/MoveToBeat"
          },
          {
            "$ref": "#/$defs/TurnToBeat"
          },
          {
            "$ref": "#/$defs/LookAtBeat"
          },
          {
            "$ref": "#/$defs/WaitBeat"
          },
          {
