{
  "$defs": {
    "PatchOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "keyframe_transform",
            "look_at",
            "play_clip",
            "ensure_camera",
            "set_frame_range"
          ],
          "title": "Op",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "op"
      ],
      "title": "PatchOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "source_title": {
      "title": "Source Title",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/PatchOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "scene_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Fingerprint"
    },
    "fingerprint_entities": {
      "items": {
        "type": "string"
      },
      "title": "Fingerprint Entities",
      "type": "array"
    },
    "fingerprint_frame": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fingerprint Frame"
    },
    "navigation_environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Navigation Environment Fingerprint"
    },
    "action_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 512,
      "title": "Action Fingerprints",
      "type": "object"
    }
  },
  "required": [
    "patch_id",
    "source_title",
    "operations"
  ],
  "title": "ScenePatch",
  "type": "object"
}
