{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/Vec3"
        },
        "maximum": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "NavigationMesh": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vertices": {
          "items": {
            "$ref": "#/$defs/Vec3"
          },
          "maxItems": 20000,
          "minItems": 3,
          "title": "Vertices",
          "type": "array"
        },
        "polygons": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 20000,
          "minItems": 1,
          "title": "Polygons",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "name",
        "vertices",
        "polygons"
      ],
      "title": "NavigationMesh",
      "type": "object"
    },
    "SceneEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "transform"
      ],
      "title": "SceneEntity",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation_euler": {
          "$ref": "#/$defs/Vec3"
        },
        "scale": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Vec3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.2",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "transform_space": {
      "const": "WORLD",
      "default": "WORLD",
      "title": "Transform Space",
      "type": "string"
    },
    "scene_name": {
      "title": "Scene Name",
      "type": "string"
    },
    "fps": {
      "default": 24.0,
      "exclusiveMinimum": 0,
      "title": "Fps",
      "type": "number"
    },
    "frame_start": {
      "default": 1,
      "title": "Frame Start",
      "type": "integer"
    },
    "frame_end": {
      "default": 250,
      "title": "Frame End",
      "type": "integer"
    },
    "frame_current": {
      "default": 1.0,
      "title": "Frame Current",
      "type": "number"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/SceneEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "navigation_meshes": {
      "items": {
        "$ref": "#/$defs/NavigationMesh"
      },
      "maxItems": 32,
      "title": "Navigation Meshes",
      "type": "array"
    },
    "navigation_environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Navigation Environment Fingerprint"
    }
  },
  "required": [
    "scene_name"
  ],
  "title": "SceneSnapshot",
  "type": "object"
}
