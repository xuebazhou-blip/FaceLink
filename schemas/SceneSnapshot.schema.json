{
  "$defs": {
    "ActionInventory": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "frame_start": {
          "title": "Frame Start",
          "type": "number"
        },
        "frame_end": {
          "title": "Frame End",
          "type": "number"
        },
        "fcurve_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Fcurve Count",
          "type": "integer"
        },
        "keyframe_count": {
          "maximum": 200000,
          "minimum": 0,
          "title": "Keyframe Count",
          "type": "integer"
        },
        "pose_bones": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Pose Bones",
          "type": "array"
        },
        "data_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Data Paths",
          "type": "array"
        },
        "fingerprint": {
          "pattern": "^action-[0-9a-f]{24}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "frame_start",
        "frame_end",
        "fcurve_count",
        "keyframe_count",
        "fingerprint"
      ],
      "title": "ActionInventory",
      "type": "object"
    },
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/Vec3"
        },
        "maximum": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "NavigationMesh": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vertices": {
          "items": {
            "$ref": "#/$defs/Vec3"
          },
          "maxItems": 20000,
          "minItems": 3,
          "title": "Vertices",
          "type": "array"
        },
        "polygons": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 20000,
          "minItems": 1,
          "title": "Polygons",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "name",
        "vertices",
        "polygons"
      ],
      "title": "NavigationMesh",
      "type": "object"
    },
    "RigBone": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "use_deform": {
          "default": true,
          "title": "Use Deform",
          "type": "boolean"
        },
        "head": {
          "$ref": "#/$defs/Vec3"
        },
        "tail": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "name",
        "head",
        "tail"
      ],
      "title": "RigBone",
      "type": "object"
    },
    "RigInventory": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "bones": {
          "items": {
            "$ref": "#/$defs/RigBone"
          },
          "maxItems": 1024,
          "title": "Bones",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "name"
      ],
      "title": "RigInventory",
      "type": "object"
    },
    "SceneEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "transform"
      ],
      "title": "SceneEntity",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation_euler": {
          "$ref": "#/$defs/Vec3"
        },
        "scale": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Vec3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "transform_space": {
      "const": "WORLD",
      "default": "WORLD",
      "title": "Transform Space",
      "type": "string"
    },
    "scene_name": {
      "title": "Scene Name",
      "type": "string"
    },
    "fps": {
      "default": 24.0,
      "exclusiveMinimum": 0,
      "title": "Fps",
      "type": "number"
    },
    "frame_start": {
      "default": 1,
      "title": "Frame Start",
      "type": "integer"
    },
    "frame_end": {
      "default": 250,
      "title": "Frame End",
      "type": "integer"
    },
    "frame_current": {
      "default": 1.0,
      "title": "Frame Current",
      "type": "number"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/SceneEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "navigation_meshes": {
      "items": {
        "$ref": "#/$defs/NavigationMesh"
      },
      "maxItems": 32,
      "title": "Navigation Meshes",
      "type": "array"
    },
    "navigation_environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Navigation Environment Fingerprint"
    },
    "rigs": {
      "items": {
        "$ref": "#/$defs/RigInventory"
      },
      "maxItems": 64,
      "title": "Rigs",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionInventory"
      },
      "maxItems": 512,
      "title": "Actions",
      "type": "array"
    }
  },
  "required": [
    "scene_name"
  ],
  "title": "SceneSnapshot",
  "type": "object"
}
